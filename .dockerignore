postcss.config.js
tailwind.config.js
eslint.config.js
design_handoff_team_view/
docs/
README.md
DOCKER_DEPLOY_GUIDE.md

# Backend cruft
backend/tests/
backend/coverage/
backend/**/*.test.js

# Simulation: ship the engine + data, drop the dev-only balance harness
simulation/*.test.js
simulation/engine/*.test.js
simulation/results.csv
simulation/sim-report.md
