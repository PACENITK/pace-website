# Build context is the repo root, but the only image built from here is
# the backend API (+ the shared simulation/ engine). Keep everything
# else out.

**/node_modules
.git
.github
*.log
**/.env
**/.env.*

# Frontend — built separately in CI and served by nginx, never in the image
src/
public/
dist/
index.html
